# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/scheduling?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT密钥 (必须设置，至少32位随机字符串)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# 默认管理员密码（仅在首次启动数据库为空时使用，留空则不创建默认管理员）
DEFAULT_ADMIN_PASSWORD=your_admin_password